ARG BASE_IMAGE_ORG
ARG BASE_IMAGE_NAME
ARG BASE_IMAGE="${BASE_IMAGE_ORG}/${BASE_IMAGE_NAME}"
ARG FEDORA_MAJOR_VERSION
ARG KERNEL
ARG COMMON
ARG BREW

FROM --platform=linux/amd64 ${COMMON} AS common
FROM ${BREW} AS brew

# /* Gravity: no ublue akmods; kernel-16k comes from the Gravity COPR (see 02-install-gravity-kernel.sh) */

FROM scratch AS ctx
COPY /build_scripts /build_scripts
COPY /build_files /build_files

# /* https://github.com/get-aurora-dev/common */
COPY --from=common /logos /system_files/shared
COPY --from=common /system_files /system_files
COPY --from=common /wallpapers /system_files/shared

# /* https://github.com/ublue-os/brew */
COPY --from=brew /system_files /system_files/shared

COPY /system_files /system_files

# /* aurora image section */
FROM ${BASE_IMAGE}:${FEDORA_MAJOR_VERSION} AS base

ARG BASE_IMAGE_NAME="${BASE_IMAGE_NAME}"
ARG FEDORA_MAJOR_VERSION=""
ARG AKMODS_FLAVOR="gravity"
ARG IMAGE_NAME="aurora"
ARG IMAGE_VENDOR="ublue-os"
ARG KERNEL=""
ARG SHA_HEAD_SHORT=""
ARG UBLUE_IMAGE_TAG="latest"
ARG VERSION=""
ARG IMAGE_FLAVOR=""

# /* so ghcurl wrapper is available to all later RUNs */
ENV PATH="/tmp/scripts/helpers:${PATH}"

# /* Install Packages, miscellaneous things that need a network */

# /* aurora-gravity: Apple Silicon (aarch64, 16K pages) */
RUN --mount=type=tmpfs,dst=/boot \
    --mount=type=tmpfs,dst=/var \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=secret,id=GITHUB_TOKEN \
    /ctx/build_scripts/shared/build-prep.sh && \
    /ctx/build_scripts/base/01-packages.sh && \
    /ctx/build_scripts/base/02-install-gravity-kernel.sh && \
    /ctx/build_scripts/base/03-fetch.sh && \
    /ctx/build_scripts/base/05-gravity-platform.sh

# /* Everything that can be done offline after things are in place should be done here */
RUN --network=none \
    --mount=type=tmpfs,dst=/boot \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build_scripts/base/16-override-install.sh && \
    /ctx/build_scripts/base/16-gravity-signing.sh && \
    /ctx/build_scripts/base/17-cleanup.sh && \
    /ctx/build_scripts/base/18-image-info.sh && \
    /ctx/build_scripts/base/19-initramfs.sh && \
    /ctx/build_scripts/shared/validate-repos.sh && \
    /ctx/build_scripts/shared/clean-stage.sh && \
    /ctx/build_scripts/shared/chunkah-xattr.sh && \
    /ctx/build_scripts/base/20-tests.sh

CMD ["/sbin/init"]

RUN --network=none \
    bootc container lint --fatal-warnings --no-truncate
